# Which chat adapter to use: "discord", "telegram", "slack", "weixin" (default: weixin)
CHAT_ADAPTER=weixin

# Which ACP agent to use: "opencode", "claude code", "codex", "gemini", "copilot",
#   "kimi", "goose", "cursor", "droid", "codebuddy" (default: opencode)
# ACP_AGENT=opencode

# ── Discord ──
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# DISCORD_ALLOWED_CHANNELS=

# ── Telegram ──
# TELEGRAM_BOT_TOKEN=

# ── Slack ──
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_SIGNING_SECRET=

# ── WeChat ──
WEIXIN_BOT_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_BOT_USER_ID=
