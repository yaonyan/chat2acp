  },
  "dependencies": {
    "@chat-adapter/discord": "latest",
    "@chat-adapter/state-memory": "^4.28.1",
    "@mcpc-tech/acp-ai-provider": "latest",
    "@yaonyan/chat-adapter-weixin": "^0.0.1",
